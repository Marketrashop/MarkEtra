generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                           String                        @id @default(uuid()) @db.Uuid
  firstName                    String                        @db.VarChar(100)
  lastName                     String                        @db.VarChar(100)
  email                        String                        @unique @db.VarChar(320)
  passwordHash                 String                        @db.VarChar(255)
  role                         UserRole                      @default(USER)
  status                       UserStatus                    @default(ACTIVE)
  heardFrom                    String?                       @db.VarChar(100)
  acceptedTermsAt              DateTime
  emailVerifiedAt              DateTime?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  balance                      Decimal                       @default(0) @db.Decimal(18, 2)
  country                      String                        @db.VarChar(100)
  phoneNumber                  String                        @unique @db.VarChar(20)
  avatarKey                    String?
  secondaryPhoneNumber         String?                       @unique @db.VarChar(20)
  deletedAt                    DateTime?
  profit                       Decimal                       @default(0) @db.Decimal(18, 2)
  kycVerified                  Boolean                       @default(false)
  totalDeposit                 Decimal                       @default(0) @db.Decimal(18, 2)
  affiliateBalance             Decimal                       @default(0) @db.Decimal(18, 2)
  activityLogs                 ActivityLog[]
  addresses                    Address[]
  affiliateListings            AffiliateListing[]
  affiliateNegotiationMessages AffiliateNegotiationMessage[]
  authRequestLogs              AuthRequestLog[]
  cart                         Cart?
  cartItems                    CartItem[]
  reviewedDeposits             Deposit[]                     @relation("DepositReviewer")
  deposits                     Deposit[]                     @relation("UserDeposits")
  emailVerificationTokens      EmailVerificationToken[]
  kycVerification              KycVerification?
  notifications                Notification[]
  orders                       Order[]
  passwordResetTokens          PasswordResetToken[]
  reviews                      ProductReview[]
  sessions                     Session[]
  subscriptions                UserSubscription[]
  wallet                       Wallet?
  walletAdjustmentsMade        WalletTransaction[]           @relation("AdminWalletTransactions")
  walletTransactions           WalletTransaction[]           @relation("UserWalletTransactions")
  wishlist                     Wishlist?
  wishlistItems                WishlistItem[]
  processedWithdrawals         Withdrawal[]                  @relation("WithdrawalProcessor")
  withdrawals                  Withdrawal[]                  @relation("UserWithdrawals")

  @@index([phoneNumber])
  @@index([secondaryPhoneNumber])
  @@index([country])
  @@index([status])
  @@index([createdAt])
}

model Address {
  id                   String   @id @default(cuid())
  userId               String   @db.Uuid
  fullName             String   @db.VarChar(200)
  phoneNumber          String   @db.VarChar(20)
  alternatePhoneNumber String?  @db.VarChar(20)
  addressLine1         String   @db.VarChar(255)
  addressLine2         String?  @db.VarChar(255)
  city                 String   @db.VarChar(100)
  state                String?  @db.VarChar(100)
  country              String   @db.VarChar(100)
  postalCode           String?  @db.VarChar(20)
  label                String?  @db.VarChar(50)
  isPrimary            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isPrimary])
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  tokenHash      String    @unique @db.VarChar(64)
  userAgent      String?   @db.VarChar(512)
  ipAddress      String?   @db.VarChar(45)
  rememberMe     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model AuthRequestLog {
  id             String          @id @default(uuid()) @db.Uuid
  type           AuthRequestType
  userId         String?         @db.Uuid
  identifierHash String          @db.VarChar(64)
  createdAt      DateTime        @default(now())
  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, identifierHash, createdAt])
  @@index([userId, type, createdAt])
}

model Wallet {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @unique @db.Uuid
  availableBalance Decimal             @default(0) @db.Decimal(18, 2)
  lockedBalance    Decimal             @default(0) @db.Decimal(18, 2)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     WalletTransaction[]
}

model WalletTransaction {
  id            String                @id @default(uuid()) @db.Uuid
  walletId      String                @db.Uuid
  depositId     String?               @unique @db.Uuid
  type          WalletTransactionType
  amount        Decimal               @db.Decimal(18, 2)
  balanceBefore Decimal               @db.Decimal(18, 2)
  balanceAfter  Decimal               @db.Decimal(18, 2)
  description   String?               @db.VarChar(500)
  createdAt     DateTime              @default(now())
  userId        String                @db.Uuid
  adminId       String?               @db.Uuid
  withdrawalId  String?               @unique @db.Uuid

  orderPayment  Order? @relation("OrderPayment")
  orderReversal Order? @relation("OrderReversal")

  admin      User?       @relation("AdminWalletTransactions", fields: [adminId], references: [id], onDelete: Restrict)
  deposit    Deposit?    @relation(fields: [depositId], references: [id])
  user       User        @relation("UserWalletTransactions", fields: [userId], references: [id], onDelete: Cascade)
  wallet     Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  withdrawal Withdrawal? @relation(fields: [withdrawalId], references: [id])

  @@index([walletId])
  @@index([userId])
  @@index([adminId])
  @@index([type])
  @@index([createdAt])
}

model Deposit {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @db.Uuid
  depositMethodId   String             @db.Uuid
  reviewedById      String?            @db.Uuid
  amount            Decimal            @db.Decimal(18, 2)
  reference         String             @unique @db.VarChar(100)
  receiptUrl        String?
  status            DepositStatus      @default(PENDING)
  reviewNote        String?
  createdAt         DateTime           @default(now())
  reviewedAt        DateTime?
  updatedAt         DateTime           @updatedAt
  depositMethod     DepositMethod      @relation(fields: [depositMethodId], references: [id])
  reviewer          User?              @relation("DepositReviewer", fields: [reviewedById], references: [id])
  user              User               @relation("UserDeposits", fields: [userId], references: [id], onDelete: Cascade)
  order             Order?
  walletTransaction WalletTransaction?

  @@index([userId])
  @@index([depositMethodId])
  @@index([reviewedById])
  @@index([status])
}

model DepositMethod {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(100)
  symbol        String    @db.VarChar(20)
  network       String    @db.VarChar(100)
  walletAddress String
  instructions  String?
  minimumAmount Decimal   @db.Decimal(18, 2)
  maximumAmount Decimal?  @db.Decimal(18, 2)
  isActive      Boolean   @default(true)
  displayOrder  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  iconKey       String?
  qrCodeKey     String?
  deposits      Deposit[]

  @@unique([symbol, network])
  @@index([isActive])
  @@index([displayOrder])
}

model Withdrawal {
  id                 String                @id @default(uuid()) @db.Uuid
  userId             String                @db.Uuid
  withdrawalMethodId String                @db.Uuid
  amount             Decimal               @db.Decimal(18, 2)
  fee                Decimal               @default(0) @db.Decimal(18, 2)
  destinationAddress String?
  reference          String                @unique @db.VarChar(100)
  status             WithdrawalStatus      @default(PENDING)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  accountHolderName  String?               @db.VarChar(150)
  accountNumber      String?               @db.VarChar(100)
  adminNote          String?
  bankAddress        String?
  bankName           String?               @db.VarChar(150)
  country            String?               @db.VarChar(100)
  currency           String?               @db.VarChar(20)
  iban               String?               @db.VarChar(100)
  ifsc               String?               @db.VarChar(50)
  processedAt        DateTime?
  processedById      String?               @db.Uuid
  receiveAmount      Decimal               @db.Decimal(18, 2)
  routingNumber      String?               @db.VarChar(100)
  sortCode           String?               @db.VarChar(50)
  swiftBic           String?               @db.VarChar(50)
  balanceType        WithdrawalBalanceType @default(WALLET)
  walletTransaction  WalletTransaction?
  processor          User?                 @relation("WithdrawalProcessor", fields: [processedById], references: [id])
  user               User                  @relation("UserWithdrawals", fields: [userId], references: [id], onDelete: Cascade)
  withdrawalMethod   WithdrawalMethod      @relation(fields: [withdrawalMethodId], references: [id])

  @@index([userId])
  @@index([withdrawalMethodId])
  @@index([processedById])
  @@index([status])
  @@index([createdAt])
}

model WithdrawalMethod {
  id                String               @id @default(uuid()) @db.Uuid
  name              String               @db.VarChar(100)
  symbol            String?              @db.VarChar(20)
  network           String?              @db.VarChar(100)
  minimumAmount     Decimal              @db.Decimal(18, 2)
  maximumAmount     Decimal?             @db.Decimal(18, 2)
  processingFee     Decimal              @default(0) @db.Decimal(18, 2)
  processingFeeType ProcessingFeeType    @default(FIXED)
  isActive          Boolean              @default(true)
  displayOrder      Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  iconKey           String?
  deletedAt         DateTime?
  placeholder       String
  type              WithdrawalMethodType
  withdrawals       Withdrawal[]

  @@unique([symbol, network])
  @@index([type])
  @@index([isActive])
  @@index([displayOrder])
}

model PlatformSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model ActivityLog {
  id          String            @id @default(uuid()) @db.Uuid
  adminId     String            @db.Uuid
  action      ActivityLogAction
  entity      String
  entityId    String
  description String?
  createdAt   DateTime          @default(now())
  link        String?
  admin       User              @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model KycVerification {
  id                 String          @id @default(cuid())
  userId             String          @unique @db.Uuid
  firstName          String
  lastName           String
  dateOfBirth        DateTime
  nationality        String
  residentialAddress String
  city               String
  state              String
  postalCode         String
  country            String
  documentType       KycDocumentType
  frontDocumentKey   String
  backDocumentKey    String?
  selfieKey          String
  status             KycStatus       @default(PENDING)
  rejectionReason    String?
  reviewedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  submittedAt        DateTime        @default(now())
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
}

model SubscriptionPlan {
  id                   String             @id @default(cuid())
  name                 String
  slug                 String             @unique
  description          String?
  price                Decimal            @db.Decimal(18, 2)
  commissionRate       Decimal            @db.Decimal(5, 2)
  maxPublishedProducts Int
  badgeName            String
  badgeColor           String
  isActive             Boolean            @default(true)
  sortOrder            Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  durationInDays       Int
  priorityLevel        Int
  subscriptions        UserSubscription[]
}

model UserSubscription {
  id                   String             @id @default(cuid())
  userId               String             @db.Uuid
  planId               String
  amountPaid           Decimal            @db.Decimal(18, 2)
  commissionRate       Decimal            @db.Decimal(5, 2)
  maxPublishedProducts Int
  priority             Int
  badgeName            String
  status               SubscriptionStatus @default(ACTIVE)
  startsAt             DateTime
  expiresAt            DateTime
  cancelledAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  badgeHex             String
  affiliateListings    AffiliateListing[]
  plan                 SubscriptionPlan   @relation(fields: [planId], references: [id])
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([expiresAt])
  @@index([planId])
}

model AffiliateListing {
  id                String                     @id @default(cuid())
  userId            String                     @db.Uuid
  subscriptionId    String
  productId         String
  status            AffiliateListingStatus     @default(PAUSED)
  totalSales        Int                        @default(0)
  totalRevenue      Decimal                    @default(0) @db.Decimal(18, 2)
  totalCommission   Decimal                    @default(0) @db.Decimal(18, 2)
  lastSaleAt        DateTime?
  publishedAt       DateTime?
  removedAt         DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  publicationStatus AffiliatePublicationStatus @default(DRAFT)
  rejectionReason   String?
  reviewedAt        DateTime?
  submittedAt       DateTime?
  interests         AffiliateInterest[]
  product           Product                    @relation(fields: [productId], references: [id])
  subscription      UserSubscription           @relation(fields: [subscriptionId], references: [id])
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([subscriptionId])
}

model AffiliateTestBuyer {
  id        String              @id @default(cuid())
  name      String              @db.VarChar(200)
  imageKey  String?
  phone     String              @db.VarChar(20)
  email     String?             @db.VarChar(320)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  interests AffiliateInterest[]

  @@index([name])
}

model AffiliateInterest {
  id                 String                        @id @default(cuid())
  affiliateListingId String
  testBuyerId        String
  status             AffiliateInterestStatus       @default(PENDING)
  offeredPrice       Decimal                       @db.Decimal(18, 2)
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  listing            AffiliateListing              @relation(fields: [affiliateListingId], references: [id], onDelete: Cascade)
  testBuyer          AffiliateTestBuyer            @relation(fields: [testBuyerId], references: [id], onDelete: Cascade)
  messages           AffiliateNegotiationMessage[]
  transaction        AffiliateTransaction?

  @@index([affiliateListingId])
  @@index([testBuyerId])
  @@index([status])
  @@index([createdAt])
}

model AffiliateNegotiationMessage {
  id           String            @id @default(cuid())
  interestId   String
  senderUserId String            @db.Uuid
  message      String
  offeredPrice Decimal?          @db.Decimal(18, 2)
  createdAt    DateTime          @default(now())
  interest     AffiliateInterest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  sender       User              @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([interestId, createdAt])
  @@index([senderUserId])
}

model AffiliateTransaction {
  id               String                     @id @default(cuid())
  interestId       String                     @unique
  agreedPrice      Decimal                    @db.Decimal(18, 2)
  commissionRate   Decimal                    @db.Decimal(5, 2)
  commissionAmount Decimal                    @db.Decimal(18, 2)
  status           AffiliateTransactionStatus @default(AWAITING_PAYMENT)
  paidAt           DateTime?
  escrowedAt       DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  interest         AffiliateInterest          @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
}

model Product {
  id                String                     @id @default(cuid())
  averageRating     Decimal                    @default(0) @db.Decimal(3, 2)
  compareAtPrice    Decimal?                   @db.Decimal(18, 2)
  createdAt         DateTime                   @default(now())
  description       String
  featured          Boolean                    @default(false)
  metaDescription   String?
  metaTitle         String?
  name              String
  price             Decimal                    @db.Decimal(18, 2)
  publishedAt       DateTime?
  sku               String?                    @unique
  slug              String                     @unique
  status            ProductStatus              @default(DRAFT)
  totalRatings      Int                        @default(0)
  totalSales        Int                        @default(0)
  updatedAt         DateTime                   @updatedAt
  affiliateListings AffiliateListing[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  categories        ProductCategoryOnProduct[]
  images            ProductImage[]
  reviews           ProductReview[]
  specifications    ProductSpecification[]
  variants          ProductVariant[]
  wishlistItems     WishlistItem[]
}

model ProductCategory {
  id          String                     @id @default(cuid())
  name        String
  slug        String                     @unique
  description String?
  imageKey    String?
  isActive    Boolean                    @default(true)
  sortOrder   Int                        @default(0)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  products    ProductCategoryOnProduct[]

  @@index([isActive])
  @@index([sortOrder])
}

model ProductCategoryOnProduct {
  productId  String
  categoryId String
  isPrimary  Boolean         @default(false)
  createdAt  DateTime        @default(now())
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
  @@index([categoryId, isPrimary])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  imageKey  String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  isPrimary Boolean  @default(false)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sortOrder])
}

model ProductVariant {
  id        String                @id @default(cuid())
  productId String
  imageKey  String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  label     String?
  type      ProductVariantType    @default(DEFAULT)
  product   Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  images    ProductVariantImage[]
  sizes     ProductVariantSize[]

  @@unique([productId, label])
  @@index([productId])
}

model ProductVariantSize {
  id            String         @id @default(cuid())
  variantId     String
  size          String?
  sku           String?
  price         Decimal?       @db.Decimal(18, 2)
  stock         Int            @default(0)
  reservedStock Int            @default(0)
  incomingStock Int            @default(0)
  allowPreorder Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  cartItems     CartItem[]
  orderItems    OrderItem[]
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  wishlistItems WishlistItem[]

  @@unique([variantId, size])
  @@index([variantId])
}

model ProductVariantImage {
  id        String         @id @default(cuid())
  variantId String
  imageKey  String
  altText   String?
  sortOrder Int            @default(0)
  isPrimary Boolean        @default(false)
  createdAt DateTime       @default(now())
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([sortOrder])
}

model ProductSpecification {
  id        String  @id @default(cuid())
  productId String
  name      String
  value     String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sortOrder])
}

model ProductReview {
  id               String   @id @default(cuid())
  productId        String
  customerName     String
  rating           Int
  title            String?
  comment          String
  verifiedPurchase Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  userId           String?  @db.Uuid
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user             User?    @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([rating])
  @@index([sortOrder])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique @db.Uuid
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id            String              @id @default(cuid())
  cartId        String
  productId     String
  quantity      Int                 @default(1)
  status        CartItemStatus      @default(CART)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  userId        String?             @db.Uuid
  variantSizeId String?
  cart          Cart                @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  user          User?               @relation(fields: [userId], references: [id])
  variantSize   ProductVariantSize? @relation(fields: [variantSizeId], references: [id])

  @@unique([cartId, productId, variantSizeId, status])
  @@index([cartId])
  @@index([productId])
  @@index([variantSizeId])
  @@index([status])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique @db.Uuid
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id            String              @id @default(cuid())
  wishlistId    String
  productId     String
  createdAt     DateTime            @default(now())
  userId        String?             @db.Uuid
  variantSizeId String?
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  user          User?               @relation(fields: [userId], references: [id])
  variantSize   ProductVariantSize? @relation(fields: [variantSizeId], references: [id])
  wishlist      Wishlist            @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId, variantSizeId])
  @@index([wishlistId])
  @@index([productId])
  @@index([variantSizeId])
}

model Order {
  id            String             @id @default(cuid())
  userId        String             @db.Uuid
  orderNumber   String             @unique
  subtotal      Decimal            @db.Decimal(18, 2)
  discount      Decimal            @default(0) @db.Decimal(18, 2)
  total         Decimal            @db.Decimal(18, 2)
  paymentMethod PaymentMethod
  paymentStatus OrderPaymentStatus @default(PENDING)
  status        OrderStatus        @default(PENDING)

  walletTransactionId         String? @unique @db.Uuid
  walletReversalTransactionId String? @unique @db.Uuid

  cryptoDepositId String? @unique @db.Uuid

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  notes String?

  deliveryAddressLine1         String? @db.VarChar(255)
  deliveryAddressLine2         String? @db.VarChar(255)
  deliveryAlternatePhoneNumber String? @db.VarChar(20)
  deliveryCity                 String? @db.VarChar(100)
  deliveryCountry              String? @db.VarChar(100)
  deliveryFullName             String? @db.VarChar(200)
  deliveryPhoneNumber          String? @db.VarChar(20)
  deliveryPostalCode           String? @db.VarChar(20)
  deliveryState                String? @db.VarChar(100)

  cryptoDeposit Deposit? @relation(fields: [cryptoDepositId], references: [id])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  walletTransaction WalletTransaction? @relation("OrderPayment", fields: [walletTransactionId], references: [id])

  walletReversalTransaction WalletTransaction? @relation("OrderReversal", fields: [walletReversalTransactionId], references: [id])

  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id               String   @id @default(cuid())
  orderId          String
  productId        String?
  quantity         Int
  stockQuantity    Int      @default(0)
  preorderQuantity Int      @default(0)
  unitPrice        Decimal  @db.Decimal(18, 2)
  totalPrice       Decimal  @db.Decimal(18, 2)
  selectedColor    String?
  selectedSize     String?
  createdAt        DateTime @default(now())
  variantSizeId    String?

  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantSize ProductVariantSize? @relation(fields: [variantSizeId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantSizeId])
}

